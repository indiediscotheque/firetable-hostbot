FIRETABLE_USER="xxxxxxxxxxxxx"

FIRETABLE_PASS="xxxxxxxxxxxxx"

YOUTUBE_KEY="xxxxxxxxxxxxx"

# SoundCloud web client id: the bot checks SoundCloud tracks with it (keep it;
# see "soundcloud" in the README)
SOUNDCLOUD_KEY="xxxxxxxxxxxxx"

# Optional, leave unset: a registered SoundCloud app, to use SoundCloud's
# official API instead (see "soundcloud" in the README)
# SOUNDCLOUD_CLIENT_ID="xxxxxxxxxxxxx"
# SOUNDCLOUD_CLIENT_SECRET="xxxxxxxxxxxxx"

FIREBASE_KEY="xxxxxxxxxxxxx"

FIREBASE_AUTH="xxxxxxxxxxxxx.firebaseapp.com"

FIREBASE_DB="https://xxxxxxxxxxxxx.firebaseio.com/"

ADAM_URL="xxxxxxxxxxxxx"

LASTFM_SESSIONKEY="xxxxxxxxxxxxx"

LASTFM_APIKEY="xxxxxxxxxxxxx"

# the API key's "Shared secret" (last.fm/api/accounts); needed to scrobble
LASTFM_SECRET="xxxxxxxxxxxxx"

LASTFM_USERNAME="xxxxxxxxxxxxx"

# the bot DJs when no one else is (set to false to turn it off)
AUTODJ=true

TRACKBROKEN_MESSAGES=false

# the firetable-user site's address: the bot follows its seasonal avatars and lights months
SITE_URL="https://indiediscotheque.com/"

# time zone for seasonal months (default: the server's, usually UTC)
TZ="America/Chicago"

# push @mentions to phones and computers (on unless set to false). The bot
# makes its own push keys and keeps them in the database; leave the VAPID_*
# lines unset unless you're bringing keys from elsewhere.
PUSH_NOTIFICATIONS=true
# VAPID_PUBLIC_KEY="xxxxxxxxxxxxx"
# VAPID_PRIVATE_KEY="xxxxxxxxxxxxx"
# VAPID_SUBJECT="mailto:you@example.com"
