FIRETABLE_USER="xxxxxxxxxxxxx"

FIRETABLE_PASS="xxxxxxxxxxxxx"

YOUTUBE_KEY="xxxxxxxxxxxxx"

# SoundCloud web client id: the bot checks SoundCloud tracks with it (keep it;
# see "soundcloud" in the README)
SOUNDCLOUD_KEY="xxxxxxxxxxxxx"

# Optional, leave unset: a registered SoundCloud app, to use SoundCloud's
# official API instead (see "soundcloud" in the README)
# SOUNDCLOUD_CLIENT_ID="xxxxxxxxxxxxx"
# SOUNDCLOUD_CLIENT_SECRET="xxxxxxxxxxxxx"

FIREBASE_KEY="xxxxxxxxxxxxx"

FIREBASE_AUTH="xxxxxxxxxxxxx.firebaseapp.com"

FIREBASE_DB="https://xxxxxxxxxxxxx.firebaseio.com/"

LASTFM_SESSIONKEY="xxxxxxxxxxxxx"

LASTFM_APIKEY="xxxxxxxxxxxxx"

# the API key's "Shared secret" (last.fm/api/accounts); needed to scrobble
LASTFM_SECRET="xxxxxxxxxxxxx"

LASTFM_USERNAME="xxxxxxxxxxxxx"

# the bot DJs when no one else is (set to false to turn it off)
AUTODJ=true

TRACKBROKEN_MESSAGES=false

# swap suggestions: every night the bot finds working copies of broken tracks
# in people's playlists (YouTube Music audio tracks; videos for playlists kept
# to videos), on unless set to false. Free sources first; checking matches
# costs about 1 YouTube unit per 50.
SWAP_SUGGESTIONS=true
# the hour it runs, in TZ (0-23, default 4)
# SWAP_HOUR=4
# most free searches of each kind in one run (default 600; the rest wait a night)
# SWAP_MAX_SEARCHES=600
# most YouTube Data API units a day for paid searches (100 each), used only for
# songs whose free search didn't answer (default 1000; 0 turns them off)
# SWAP_API_UNITS=1000
# a song YouTube Music certainly has, searched when searches come back with no
# songs, to tell a catalog that isn't answering from songs that aren't there
# YTMUSIC_CANARY="Daft Punk One More Time"

# the bot's "YOUTUBE MUSIC" playlist, synced every day with the official Indie
# Discotheque year playlists on YouTube Music: broken tracks and YouTube
# videos replaced with their YouTube Music audio track, new songs added (no
# DJ-mixed compilation tracks), duplicates removed, then shuffled (on unless
# set to false). About 1 YouTube unit per 50 tracks.
YTMUSIC_SYNC=true
# the hour it runs, in TZ (0-23, default 5)
# YTMUSIC_SYNC_HOUR=5
# the playlist's name in the bot's account (default YOUTUBE MUSIC)
# YTMUSIC_PLAYLIST="YOUTUBE MUSIC"
# other year playlists instead of the official 2001-2026 ones: "year=link"
# (or just links), comma separated. Add the new year's here when it starts.
# YTMUSIC_SOURCES="2027=https://music.youtube.com/playlist?list=PL..., 2026=https://music.youtube.com/playlist?list=PLTW5JZnPjE_q3bQltmawTeCJNF2VfH_dN"
# the same song within this many seconds of the same length is a duplicate (default 3)
# YTMUSIC_DUPE_SECONDS=3
# most YouTube Music searches (for broken tracks and videos) in one sync (default 400; the rest wait a day)
# YTMUSIC_MAX_SEARCHES=400

# genre playlists on YouTube Music: a public playlist per genre on the room's
# YouTube account with the genre's 50 room favorites, updated daily (see
# README). Off until these three are set; tools/youtube-auth.js prints them.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# the hour it runs, in TZ (default 6); the quota units a run may spend
# (default 4000 of YouTube's 10,000 a day; each song added or taken out is 50);
# songs per playlist (default 50); YTM_GENRE_PLAYLISTS=false turns it off
# YTM_PLAYLIST_HOUR=6
# YTM_PLAYLIST_UNITS=4000
# YTM_GENRE_SONGS=50

# the firetable-user site's address: the bot follows its seasonal avatars and lights months
SITE_URL="https://indiediscotheque.com/"

# time zone for seasonal months (default: the server's, usually UTC)
TZ="America/Chicago"

# public data for the site's Discover side: room charts, new releases and the
# chat peek (on unless set to false; see README, discover)
DISCOVER=true

# push @mentions to phones and computers (on unless set to false). The bot
# makes its own push keys and keeps them in the database; leave the VAPID_*
# lines unset unless you're bringing keys from elsewhere.
PUSH_NOTIFICATIONS=true
# VAPID_PUBLIC_KEY="xxxxxxxxxxxxx"
# VAPID_PRIVATE_KEY="xxxxxxxxxxxxx"
# VAPID_SUBJECT="mailto:you@example.com"

# DJs who leave (see README, away DJs): closed the browser -> asked after
# AWAY_CLOSED_MIN minutes, on the bus AWAY_ANSWER_MIN minutes later; only the
# connection dropped (asleep, frozen tab) -> asked after AWAY_LOST_HOURS.
# Idle DJs with the room open are never removed.
# AWAY_CLOSED_MIN=5
# AWAY_ANSWER_MIN=5
# AWAY_LOST_HOURS=3
