{
  "rules": {
    ".write": false,
    ".read": false,
      "chatFeed": {
      ".read": true,
      "$comment": {
        ".read": true,
        ".write": "(auth.uid != null && (newData.child('chatID').exists() || root.child('users/' + auth.uid + '/hostbot').val() == true)&& ((!data.exists() || root.child('users/' + auth.uid + '/hostbot').val() == true || newData.child('hidden').val() == true) && root.child('banned/' + auth.uid).val() != true))",
        "chatID":{
          ".validate": "newData.isString() && newData.parent().parent().parent().child('chatData').child(newData.val()).exists() && (!newData.parent().parent().parent().child('chatData').child(newData.val()).child('feedID').exists() || newData.parent().parent().parent().child('chatData').child(newData.val()).child('feedID').val() == $comment)"
        },
        "hidden":{
             ".validate": "newData.isBoolean() && (auth.uid != null && (root.child('users/' + auth.uid + '/supermod').val() == true || root.child('users/' + auth.uid + '/mod').val() == true))"
          },
        "$other": {
          ".validate": false
        }
      }
    },
    "chatData": {
      ".read": false,
      "$comment": {
        ".read": "root.child('banned/' + auth.uid).val() != true && (root.child('blocks').child(auth.uid).child(data.child('id').val()).val() != true && root.child('blocks').child(data.child('id').val()).child(auth.uid).val() != true)",
        ".write": "auth.uid != null && root.child('banned/' + auth.uid).val() != true && (root.child('users/' + auth.uid + '/hostbot').val() == true || (newData.exists() && newData.child('id').val() == auth.uid && (!data.exists() || data.child('id').val() == auth.uid)) || (!newData.exists() && data.child('id').val() == auth.uid))",
        ".validate": "newData.hasChildren(['id', 'txt', 'time']) && newData.child('txt').isString() && newData.child('txt').val().length > 0 && newData.child('txt').val().length <= 240",
        "id": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
        },
        "txt": {
          ".validate": "newData.isString()"
        },
        "time": {
          ".validate": "newData.val() == now || newData.val() == data.val()"
        },
        "card": {
          ".validate": "(root.child('cards/' + newData.val() + '/owner').val() == auth.uid) || (root.child('users/' + auth.uid + '/hostbot').val() == true)"
        },
        "name": {
          ".validate": "(root.child('users/' + auth.uid + '/username').val() == newData.val()) || (auth.uid == newData.val())"
        },
        "botCmd": {
          ".validate": "newData.isBoolean()"
        },
        "forSong": {
          ".validate": "newData.isNumber()"
        },
        "feedID": {
          ".validate": "newData.isString() && newData.parent().parent().parent().child('chatFeed').child(newData.val()).child('chatID').val() == $comment"
        },
        "reactions": {
          "$emoji": {
            ".validate": "$emoji.matches(/^[a-z0-9_+-]{1,40}$/)",
            "$reactor": {
              ".write": "auth.uid != null && auth.uid == $reactor && root.child('banned/' + auth.uid).val() != true && data.parent().parent().parent().child('txt').exists()",
              ".validate": "newData.val() == true && $reactor == auth.uid"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "typing": {
      ".read": true,
      "$uid": {
        ".write": "auth.uid == $uid && root.child('banned/' + auth.uid).val() != true",
        ".validate": "newData.hasChildren(['name', 'at']) && newData.child('name').val() == root.child('users/' + $uid + '/username').val() && newData.child('at').val() == now",
        "name": {
          ".validate": "newData.isString()"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "mentions": {
      ".read": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      "$uid": {
        ".read": "auth.uid == $uid",
        ".indexOn": "time",
        ".write": "auth.uid == $uid || root.child('users/' + auth.uid + '/hostbot').val() == true",
        "$mention": {
          "read": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "notices": {
      ".read": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      "$uid": {
        ".read": "auth.uid == $uid",
        ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
        ".indexOn": "time",
        "$notice": {
          ".write": "auth.uid == $uid && !newData.exists()",
          ".validate": "newData.hasChildren(['txt', 'time'])",
          "txt": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "time": { ".validate": "newData.isNumber()" },
          "kind": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "card": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "expires": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "songBpm": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "bpm": {
      ".read": true,
      "$track": {
        ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
        ".validate": "$track.matches(/^[0-9]{1,2}_[A-Za-z0-9_-]{1,64}$/)"
      }
    },
    "playlistPrefs": {
      "$uid": {
        ".read": "auth.uid == $uid",
        ".write": "auth.uid == $uid && root.child('banned/' + auth.uid).val() != true",
        "defaultList": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "defaultName": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "order": {
          "$list": {
            ".validate": "newData.isNumber()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "grabs": {
      "$djid": {
        ".read": "auth.uid == $djid",
        "$track": {
          "$uid": {
            ".write": "auth.uid == $uid && auth.uid != $djid && !data.exists() && root.child('banned/' + auth.uid).val() != true && root.child('users/' + $djid).exists()",
            ".validate": "newData.val() == now && $track.matches(/^[0-9]{1,2}_[A-Za-z0-9_-]{1,64}$/)"
          }
        }
      }
    },
    "nameClaim": {
      ".read": true,
      "$uname": {
        ".write": "auth.uid != null && root.child('banned/' + auth.uid).val() != true && (newData.val() == auth.uid || root.child('users/' + auth.uid + '/hostbot').val() == true)",
        ".validate": "newData.isString() && $uname.matches(/^[0-9a-z_]{1,22}$/) && (!data.exists() || data.val() == newData.val() || !root.child('users/' + data.val() + '/username').isString() || root.child('users/' + data.val() + '/username').val().toLowerCase() != $uname)"
      }
    },
    "thescreen": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "dance": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "lights": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "cardSpecial": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "theme": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "botLock": {
      ".read": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "pushKey": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{86,88}$/)"
    },
    "pushVapid": {
      ".read": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".validate": "newData.child('publicKey').isString() && newData.child('privateKey').isString()"
    },
    "pushSubs": {
      ".read": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      "$uid": {
        ".read": "auth.uid == $uid",
        ".write": "(auth.uid == $uid && root.child('banned/' + auth.uid).val() != true) || root.child('users/' + auth.uid + '/hostbot').val() == true",
        "$device": {
          ".validate": "$device.matches(/^[A-Za-z0-9_-]{8,64}$/) && newData.hasChildren(['endpoint', 'p256dh', 'auth', 'seen'])",
          "endpoint": {
            ".validate": "newData.isString() && newData.val().length <= 1024 && newData.val().matches(/^https:\\/\\/(fcm\\.googleapis\\.com|([a-z0-9-]+\\.)*push\\.apple\\.com|([a-z0-9-]+\\.)*push\\.services\\.mozilla\\.com|([a-z0-9-]+\\.)*notify\\.windows\\.com)\\//)"
          },
          "p256dh": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{86,88}$/)"
          },
          "auth": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{16,44}$/)"
          },
          "key": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{86,88}$/)"
          },
          "device": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "everyone": {
            ".validate": "newData.isBoolean()"
          },
          "seen": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "autodj": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "globalArtists": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "globalTracks": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      "$trackid":{
        "artist":{
          ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true || root.child('users/' + auth.uid + '/mod').val() == true || root.child('users/' + auth.uid + '/supermod').val() == true",
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "title":{
          ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true || root.child('users/' + auth.uid + '/mod').val() == true || root.child('users/' + auth.uid + '/supermod').val() == true",
          ".validate": "newData.isString() && newData.val().length <= 500"
        }
      }
    },
    "globalTrackRaws": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "globalSongs": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "globalWorks": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "globalSongKeys": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "globalWorkKeys": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "globalSongsMeta": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "playLog": {
      ".read": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".indexOn": ["w"]
    },
    "tagLog": {
      ".read": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".indexOn": ["at"],
      "$entry": {
        ".write": "!data.exists() && auth.uid != null && (root.child('users/' + auth.uid + '/mod').val() == true || root.child('users/' + auth.uid + '/supermod').val() == true) && root.child('banned/' + auth.uid).val() != true",
        ".validate": "newData.hasChildren(['k', 'a', 't', 'at']) && (root.child('users/' + auth.uid + '/hostbot').val() == true || (newData.child('by').val() == auth.uid && newData.child('at').val() == now))",
        "k": { ".validate": "newData.isString() && newData.val().matches(/^[12][A-Za-z0-9_-]{1,64}$/)" },
        "a": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "t": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "fa": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "ft": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "by": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "historyArchive": {
      ".read": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "historyDecisions": {
      ".read": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "tagReview": {
      ".read": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".indexOn": ["n"]
    },
    "globalDjs": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "cards": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".indexOn": ["owner"]
    },
    "cardCount": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "tagUpdate": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "songToPlay": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "songHistory": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      "$histitem": {
        ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true || root.child('users/' + auth.uid + '/mod').val() == true || root.child('users/' + auth.uid + '/supermod').val() == true",
        "artist": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "title": { ".validate": "newData.isString() && newData.val().length <= 500" }
      }
    },
    "newMusic": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "colors": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "queues": {
      "$uid": {
        ".read": "($uid == auth.uid || root.child('users/' + auth.uid + '/hostbot').val() == true) && root.child('banned/' + auth.uid).val() != true",
        ".write": "($uid == auth.uid || root.child('users/' + auth.uid + '/hostbot').val() == true) && root.child('banned/' + auth.uid).val() != true",
        ".indexOn": "cid",
        "$track": {
          ".validate": "newData.hasChildren()",
          "type": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 8)" },
          "cid": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 256)" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "img": { ".validate": "newData.isString() && newData.val().length <= 2048" },
          "url": { ".validate": "newData.isString() && newData.val().length <= 2048" },
          "flagged": {
            ".validate": "newData.hasChildren()",
            "date": { ".validate": "newData.isNumber()" },
            "code": { ".validate": "newData.isNumber()" }
          },
          "$other": { ".validate": "!newData.isString() || newData.val().length <= 2048" }
        }
      }
    },
    "playlists": {
      ".read": false,
      "$uid": {
        ".read": "($uid == auth.uid || root.child('users/' + auth.uid + '/hostbot').val() == true) && root.child('banned/' + auth.uid).val() != true",
        ".write": "($uid == auth.uid || root.child('users/' + auth.uid + '/hostbot').val() == true) && root.child('banned/' + auth.uid).val() != true",
        "$listid": {
          "name": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "list":{
            ".indexOn": "cid",
            "$track": {
              ".validate": "newData.hasChildren()",
              "type": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 8)" },
              "cid": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 256)" },
              "name": { ".validate": "newData.isString() && newData.val().length <= 1000" },
              "img": { ".validate": "newData.isString() && newData.val().length <= 2048" },
              "url": { ".validate": "newData.isString() && newData.val().length <= 2048" },
              "flagged": {
                ".validate": "newData.hasChildren()",
                "date": { ".validate": "newData.isNumber()" },
                "code": { ".validate": "newData.isNumber()" }
              },
              "$other": { ".validate": "!newData.isString() || newData.val().length <= 2048" }
            }
          }
        }
      }
    },
    "blocks": {
      ".read": false,
      "$uid": {
          ".read": "($uid == auth.uid || root.child('users/' + auth.uid + '/hostbot').val() == true) && root.child('banned/' + auth.uid).val() != true",
          ".write": "($uid == auth.uid || root.child('users/' + auth.uid + '/hostbot').val() == true) && root.child('banned/' + auth.uid).val() != true",
            "$blockedID":{
              ".validate": "newData.val() == true && root.child('users/'+ $blockedID + '/mod').val() !== true && root.child('users/'+ $blockedID + '/supermod').val() !== true && root.child('users/'+ $blockedID + '/hostbot').val() !== true"
            }
      }
    },
    "table": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "waitlist": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "playdex": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },

    "playlimit": {
      ".read": true,
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true"
    },
    "banned": {
      ".read": "root.child('users/' + auth.uid + '/supermod').val() == true || root.child('users/' + auth.uid + '/hostbot').val() == true",
      ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true",
      "$uid": {
        ".read": "($uid == auth.uid || root.child('users/' + auth.uid + '/hostbot').val() == true)",
        ".write": "root.child('users/' + auth.uid + '/hostbot').val() == true || root.child('users/' + auth.uid + '/supermod').val() == true",
        ".validate": "(root.child('users/' + $uid + '/supermod').val() != true) && ($uid != 'OiJ7rcoNaNdvk3KlFGUJx1Fqjer2')"

      }
    },
    "users": {
      ".read": true,
      ".indexOn": ["status", "username"],
      "$uid": {
        "status": {
          ".write": "auth.uid == $uid && (root.child('banned/' + auth.uid).val() != true || newData.val() == false)",
          ".validate": "newData.isBoolean()"
        },
        "idle": {
          ".write": "auth.uid == $uid && (root.child('banned/' + auth.uid).val() != true)",
            ".validate": "newData.hasChildren(['since'])",
            "isIdle": {
                ".validate": "newData.isBoolean()"
            },
            "audio": {
                ".validate": "newData.isNumber() || newData.isBoolean()"
            },
            "since": {
                ".validate": "newData.val() == now"
            },
            "$other": {
                ".validate": false
            }
        },
        "joined": {
          ".write": "auth.uid == $uid",
          ".validate": "newData.val() == now && !data.exists()"
        },
        "mod": {
          ".write": "root.child('users/' + auth.uid + '/supermod').val() == true",
          ".validate": "newData.isBoolean()"
        },
        "supermod": {
          ".write": "false"
        },
        "hostbot": {
          ".write": "false"
        },
        "selectedList": {
          ".write": "auth.uid == $uid && root.child('banned/' + auth.uid).val() != true",
          ".validate": "(newData.isString() && newData.val().length <= 40) || newData.val() == 0"
        },
        "avatarStyle": {
          ".write": "auth.uid == $uid && root.child('banned/' + auth.uid).val() != true",
          ".validate": "newData.isString() && newData.val().matches(/^(robohash:set[1-4]|dicebear:[a-z0-9-]{1,32})$/)"
        },
        "username": {
          ".write": "auth.uid == $uid && root.child('banned/' + auth.uid).val() != true",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-zA-Z_]{1,22}$/) && root.child('nameClaim/' + newData.val().toLowerCase()).val() == auth.uid"
        }
      }
    }
  }
}
